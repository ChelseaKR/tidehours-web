{#
  The link to one of this station's printed tide tables on Amazon
  (docs/DECISIONS.md 0030). station.html.jinja includes this once for each
  listed book of the station whose year is not over, its own booklet
  first. One sentence, one plain link: no Associates tag, no query string,
  no price, no claim, no image and no click event.
#}
<p class="booklet" data-booklet="{{ booklet.asin }}">{{ booklet.before }} <a href="{{ booklet.url }}" rel="{{ booklet.rel }}">{{ booklet.title }}</a>{{ booklet.after }}</p>
