{#
  Google Analytics 4 (docs/DECISIONS.md 0007), copied from Lake Notice. base.html.jinja includes this only
  when a measurement ID is configured (--ga4-id; empty by default).

  gtag.js is added by script rather than by a <script src> tag, so a browser
  that sends Global Privacy Control or Do Not Track gets nothing: no
  dataLayer, no request to Google, no cookie. The guard runs first.

  The same goes for a visitor who opted out with the footer button in
  base.html.jinja: that choice is a localStorage flag on this device, read
  here before anything loads.

  Consent Mode v2 defaults: the three ad signals are denied everywhere;
  analytics_storage is denied in the EEA, the UK and Switzerland (the
  region-specific default wins there) and granted elsewhere. Google signals
  and ad personalization are off in the config.

  A click on an affiliate link (data-ga-event="gear_click", only on the
  English king-tide page when the Amazon tag is set) is counted with its
  placement, link type and host only. The handler is rendered only on the
  page that has those links, so switching them on changes no other page.
#}
<script>
(function () {
  var n = navigator, w = window, d = document;
  var id = {{ ga4_measurement_id|tojson }};
  var key = "tidehours:analytics-opt-out";
  var dnt = n.doNotTrack || w.doNotTrack || n.msDoNotTrack;
  var signal = n.globalPrivacyControl === true || dnt === "1" || dnt === "yes";
  var optedOut = false;
  try { optedOut = w.localStorage.getItem(key) === "1"; } catch (e) {}

  // The footer's opt-out control. It stays hidden unless this runs.
  d.addEventListener("DOMContentLoaded", function () {
    var box = d.getElementById("analytics-choice");
    var button = d.getElementById("analytics-opt-out");
    var status = d.getElementById("analytics-status");
    if (!box || !button || !status) return;
    box.hidden = false;
    if (signal) {
      status.textContent = "Analytics is off: your browser sends Global Privacy Control or Do Not Track.";
      return;
    }
    function show(message) {
      button.textContent = optedOut ? "Opt back in" : "Opt out of analytics";
      status.textContent = message;
    }
    button.hidden = false;
    show(optedOut ? "Analytics is off on this device." : "");
    button.addEventListener("click", function () {
      optedOut = !optedOut;
      w["ga-disable-" + id] = optedOut;
      try {
        if (optedOut) w.localStorage.setItem(key, "1");
        else w.localStorage.removeItem(key);
      } catch (e) {
        show("Your browser would not save this choice, so it lasts only until you leave this page.");
        return;
      }
      show(optedOut ? "Analytics is off on this device." : "Analytics is back on from the next page you open.");
    });
  });

  if (n.globalPrivacyControl === true) return;
  if (dnt === "1" || dnt === "yes") return;
  if (optedOut) return;
  w.dataLayer = w.dataLayer || [];
  function gtag() { w.dataLayer.push(arguments); }
  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "granted"
  });
  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    region: {{ ga4_denied_regions|tojson }}
  });
  gtag("js", new Date());
  gtag("config", {{ ga4_measurement_id|tojson }}, {
    allow_google_signals: false,
    allow_ad_personalization_signals: false
  });
  var s = document.createElement("script");
  s.async = true;
  s.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent({{ ga4_measurement_id|tojson }});
  document.head.appendChild(s);
{% if affiliate is defined and affiliate %}

  // Affiliate link clicks (docs/DECISIONS.md 0016): an ordinary event, sent
  // only past the guards above. It reads the link's data attributes, never
  // its address, so the tracking ID and search terms never reach Google.
  d.addEventListener("click", function (ev) {
    var a = ev.target && ev.target.closest ? ev.target.closest("a[data-ga-event]") : null;
    if (!a || a.getAttribute("data-ga-event") !== "gear_click") return;
    gtag("event", "gear_click", {
      placement: a.getAttribute("data-ga-placement") || "",
      link_type: a.getAttribute("data-ga-type") || "",
      link_host: a.getAttribute("data-ga-host") || ""
    });
  });
{% endif %}
})();
</script>
