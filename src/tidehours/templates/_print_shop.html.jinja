{#
  The link to the Tide Hours print shop on Etsy (docs/DECISIONS.md 0029).
  about.html.jinja and the English king_tides.html.jinja include this only
  when a shop address is configured. One sentence, one plain link: no price,
  no claim, no image, no tracking parameter and no click event. The state
  calendars add their towns (0051), and the West Coast ones and the hub
  their king-tide print sentences (0058), under the same rules.
#}
<section class="print-shop" aria-labelledby="print-shop" data-print-shop="etsy">
  <h2 id="print-shop">{{ print_shop.text.heading }}</h2>
  <p>{{ print_shop.text.before }} <a href="{{ print_shop.url }}" rel="{{ print_shop.rel }}">{{ print_shop.text.link }}</a>{{ print_shop.text.after }}</p>
{% if shop_towns is defined and shop_towns %}
  <p data-shop-towns>{{ shop_towns.before }} <a href="/{{ shop_towns.path }}">{{ shop_towns.label }}</a>{{ shop_towns.after }}</p>
{% endif %}
{#- The king-tide print sentences (docs/DECISIONS.md 0058): on the hub and
    the West Coast calendars, each linking straight to its Etsy listings,
    with no attribute of its own and no tracking parameter (the shop_click
    handler of 0057 counts a click). #}
{% for parts in king_prints.get(path, []) %}
  <p data-king-prints>{% for words, href in parts %}{% if href %}<a href="{{ href }}" rel="{{ print_shop.rel }}">{{ words }}</a>{% else %}{{ words }}{% endif %}{% endfor %}</p>
{% endfor %}
</section>
