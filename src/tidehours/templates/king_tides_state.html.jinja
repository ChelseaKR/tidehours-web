{% extends "base.html.jinja" %}
{% block title %}{{ state_name }} king tides 2026–27: dates by month, Nov–Feb | Tide Hours{% endblock %}
{% block description %}Predicted king tide dates in {{ state_name }} for winter 2026–27, month by month from November 2026 to February 2027: each place's highest tides, local time and height at {{ kt_station_count }} NOAA stations.{% endblock %}
{% block jsonld %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": state_name ~ " king tides 2026–27 by month",
  "url": base_url ~ path,
  "about": {"@type": "State", "name": state_name},
  "isBasedOn": "https://tidesandcurrents.noaa.gov/"
}|tojson }}</script>
{% endblock %}
{% block content %}
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/king-tides/">King tides</a></li>
  </ol>
</nav>
<h1>{{ state_name }} king tides 2026–27, by month</h1>
<p class="lead">The days with the highest predicted tides from {{ fmt_long_date(calendar_first, "en", kc) }} to {{ fmt_long_date(calendar_last, "en", kc) }} at {{ kt_station_count }} NOAA tide stations in {{ state_name }}, computed from NOAA's harmonic constants.</p>
<p>These are predictions, not observations or flood forecasts. Times are Pacific time. Heights are feet above mean lower low water (MLLW), the datum on NOAA charts. “Above a normal high tide” is the height above mean higher high water (MHHW), the average of each day's higher high tide at that station{% if epochs|length == 1 %}, for NOAA's {{ epochs[0]|replace("-", "–") }} tidal datum epoch{% else %}, for NOAA's tidal datum epochs {{ epochs|join(", ")|replace("-", "–") }}{% endif %}.</p>
<p class="meta">Computed from NOAA CO-OPS harmonic constants retrieved {{ fmt_long_date(retrieved, "en", kc) }}.</p>

<section class="callout warning" aria-labelledby="kt-safety">
  <h2 id="kt-safety">{{ kc.safety.heading }}</h2>
  <p>{{ kc.safety.body[0] }}</p>
  <p>Check the <a href="https://www.weather.gov/">National Weather Service</a> for coastal flood warnings, and don't go out for photos unless it's safe.</p>
</section>

{% for m in calendar %}
{% set month_name = kc.monthsLong[m.month - 1] ~ " " ~ m.year %}
{% set mid = "m-" ~ m.year ~ "-" ~ "%02d"|format(m.month) %}
<section aria-labelledby="{{ mid }}" data-kt-cal-month="{{ m.year }}-{{ "%02d"|format(m.month) }}">
  <h2 id="{{ mid }}">{{ month_name }}</h2>
  {% if m.runs %}
  {% set firsts = m.runs|map(attribute="first")|list %}
  {% set lasts = m.runs|map(attribute="last")|list %}
  {% set peaks = m.runs|map(attribute="peak")|map(attribute="date")|list %}
  <p>{% if m.stations == kt_station_count %}All {{ kt_station_count }}{% else %}{{ m.stations }} of {{ kt_station_count }}{% endif %} stations have a run of the year's highest predicted tides that peaks in {{ month_name }}{% if m.runs|length == m.stations + 1 %} (one has two){% elif m.runs|length > m.stations %} (some have two){% endif %}. Together the runs span {{ fmt_range(firsts|min, lasts|max, "en", kc) }}, {% if peaks|min == peaks|max %}highest on {{ fmt_date(peaks|min, "en", kc) }}{% else %}highest {{ fmt_range(peaks|min, peaks|max, "en", kc) }} depending on the place{% endif %}.</p>
  <div class="table-scroll" role="region" tabindex="0" aria-labelledby="{{ mid }}-cap">
  <table class="events">
    <caption id="{{ mid }}-cap">Predicted king tides in {{ state_name }}, {{ month_name }}</caption>
    <thead><tr>
      <th scope="col">Place</th>
      <th scope="col">Days</th>
      <th scope="col">Highest tide</th>
      <th scope="col">Height (MLLW)</th>
      <th scope="col">Above a normal high tide</th>
    </tr></thead>
    <tbody>
    {% for u in m.runs %}
      <tr data-kt-cal="{{ u.stamp() }}">
        <th scope="row"><a href="/stations/{{ u.season.id }}/">{{ u.season.place }}</a></th>
        <td>{{ fmt_range(u.first, u.last, "en", kc) }}</td>
        <td>{{ fmt_date(u.peak.date, "en", kc) }}, {{ fmt_time(u.peak.time, "en") }}</td>
        <td>{{ fmt_feet(u.peak.height, "en", kc) }}</td>
        <td>{{ fmt_feet(u.season.above_mhhw(u.peak), "en", kc, true) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if m.stations < kt_station_count %}
  <p class="meta">The other stations have no run of their year's highest tides peaking in {{ month_name }}. Their high tides this month are predicted, but lower than the peak of each of their runs on this page.</p>
  {% endif %}
  {% else %}
  <p>At none of the {{ kt_station_count }} stations does a run of the year's highest predicted tides peak in {{ month_name }}. That is not a prediction of no high tides: high tides this month are predicted, but lower than the peak of each run listed in the other months. Each station's page has its predicted tides for today and tomorrow.</p>
  {% endif %}
</section>
{% endfor %}

<section aria-labelledby="kt-how">
  <h2 id="kt-how">How these dates were picked</h2>
  <p>Each station's runs are the ones on the <a href="/king-tides/#kt-{{ state_code }}">king-tide page</a>: from every predicted high tide in the twelve months from November 1, 2026, the 20 highest days are grouped into runs of nearby days, the five runs with the highest peaks are kept, and each is widened to neighboring days within 3% of the station's tidal range of its peak. This page lists the runs whose highest tide falls between November and February, under the month of that highest tide; a run can start in the month before. Runs at other times of year, and each day's highest tide in a run, are on the <a href="/king-tides/#kt-{{ state_code }}">king-tide page</a>.</p>
  <p>Other places on the coast: <a href="/king-tides/">all West Coast king tides</a>{% for code, pair in calendar_states.items() if code != state_code %} · <a href="/{{ calendar_path(code) }}">{{ pair[0] }} by month</a>{% endfor %}{% if state_path %} · <a href="/{{ state_path }}">{{ state_name }} tide times</a>{% endif %}.</p>
</section>
{% endblock %}
