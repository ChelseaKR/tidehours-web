{% extends "base.html.jinja" %}
{% block title %}{{ name }} has moved | Tide Hours{% endblock %}
{% block description %}{{ name }} tide stations are now listed under {{ state_name }}.{% endblock %}
{% block alternates %}<meta http-equiv="refresh" content="0; url=/{{ canonical_path }}">
{% endblock %}
{% block content %}
<h1>{{ name }} has moved</h1>
<p>These stations are now listed under {{ state_name }}. <a href="/{{ canonical_path }}">Go to {{ name }}, {{ state_name }}</a>.</p>
{% endblock %}
