{% extends "base.html.jinja" %}
{% block title %}{{ region.name }}{% if state.code != "other" %}, {{ state.name }}{% endif %} tide times | Tide Hours{% endblock %}
{% block description %}Today's tide times at {{ region.stations|length }} NOAA tide station{{ "s" if region.stations|length != 1 }} in {{ region.name }}{% if state.code != "other" %}, {{ state.name }}{% endif %}.{% endblock %}
{% block content %}
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/{{ state.path }}">{{ state.name }}</a></li></ol></nav>
<h1>{{ region.name }} tide times</h1>
<p class="lead">{{ region.stations|length }} NOAA tide prediction station{{ "s" if region.stations|length != 1 }} in NOAA's {{ region.name }} region{% if state.code != "other" %}, {{ state.name }}{% endif %}.</p>
<ul class="stations">
{% for s in region.stations %}
  <li><a href="/stations/{{ s.id }}/">{{ s.name }}</a>{% if s.is_subordinate %} <span class="tag">from a reference station</span>{% endif %}</li>
{% endfor %}
</ul>
{% endblock %}
