{% extends "base.html.jinja" %}
{% set today = days[0] %}
{% block title %}{{ station_title(place) }}{% endblock %}
{% block description %}{{ station_description(place, days, ("King tides " ~ fmt_range(king_link.up.first, king_link.up.last, "en", kc) ~ ".") if king_link and king_link.own else "") }}{% endblock %}
{% block jsonld %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": station.display_name ~ " tide times",
  "url": base_url ~ path,
  "dateModified": built,
  "about": {"@type": "Place", "name": station.display_name,
            "geo": {"@type": "GeoCoordinates", "latitude": station.lat, "longitude": station.lon}},
  "isBasedOn": "https://tidesandcurrents.noaa.gov/noaatidepredictions.html?id=" ~ station.id
}|tojson }}</script>
{% with crumbs = [["Home", ""], [state.name, state.path]] + ([[region.name, region.path]] if region else []) %}{% include "_breadcrumb_jsonld.html.jinja" %}{% endwith %}
{% endblock %}
{% block main_attrs %} data-station-date="{{ today.date.isoformat() }}" data-tz="{{ station.tz }}"{% endblock %}
{% block content %}
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/{{ state.path }}">{{ state.name }}</a></li>
    {% if region %}<li><a href="/{{ region.path }}">{{ region.name }}</a></li>{% endif %}
  </ol>
</nav>
<h1>{{ place }} tides today</h1>
<p class="stale" id="stale" role="status" hidden></p>
{#- The answer first (docs/DECISIONS.md 0032): each day's highs, then its
    lows, by date. The script below adds "Today" or "Tomorrow" from the
    station's own clock and hides a day that has passed. -#}
<div class="answer">
{% for kind in ("High", "Low") %}
  <h2 id="q-{{ kind|lower }}">When is {{ kind|lower }} tide at {{ place }} today?</h2>
  <ul class="answer-days">
  {% for day in days %}
    {% set these = day.events|selectattr("kind", "equalto", kind)|list %}
    <li data-date="{{ day.date.isoformat() }}"><span class="day-label"></span>{{ day.date.strftime("%A") }}, {{ day.date|short_date }}: {% if these %}{% for e in these %}<strong><time datetime="{{ e.iso }}">{{ e.time }}</time></strong> ({{ e.height_ft }}){{ ", " if not loop.last }}{% endfor %}{% else %}no {{ kind|lower }} tide predicted{% endif %}</li>
  {% endfor %}
  </ul>
{% endfor %}
</div>
<p class="lead">Predicted for NOAA station {{ station.id }}{% if region %}, {{ region.name }}{% endif %}. {% set zone = zone_label(station.tz) %}{% if zone == zone_unknown %}Times are local to the station{% else %}Times are {{ zone }}, local to the station{% endif %}; heights are feet above mean lower low water (MLLW). The tide chart and table for each day are below.</p>
{% if station.filed_by == "reference" %}
<p>NOAA's station list gives this station no state. It is listed under {{ state.name }}, the state of the reference station NOAA predicts it from.</p>
{% elif station.filed_by in ("territory", "name") %}
<p>NOAA's station list gives this station no state. It is listed under {{ state.name }}, where NOAA's station name places it.</p>
{% elif station.filed_by == "place" %}
<p>NOAA's station list gives this station no state. {{ station.correction_note }}</p>
{% elif station.filed_by == "correction" %}
<p>NOAA's station list codes this station {{ station.noaa_state }}. {{ station.correction_note }}</p>
{% endif %}

{% if king_link %}
{% set u = king_link.up %}
<section class="callout kt-link" aria-labelledby="king" data-kt-run="{{ u.stamp() }}">
  {% if king_link.own %}
  <h2 id="king">King tides {{ fmt_range(u.first, u.last, "en", kc) }}</h2>
  <p>The next run of this station's highest predicted tides of the season: {{ fmt_range(u.first, u.last, "en", kc) }}, highest on {{ fmt_date(u.peak.date, "en", kc) }} at {{ fmt_time(u.peak.time, "en") }}, {{ u.peak.height|feet }} ({{ u.season.above_mhhw(u.peak)|feet }} above a normal high tide).</p>
  <p><a href="/king-tides/#station-{{ u.season.id }}">King tide dates, times and heights on the West Coast</a>.</p>
  {% else %}
  <h2 id="king">King tides nearby, {{ fmt_range(u.first, u.last, "en", kc) }}</h2>
  <p>The nearest station on the king-tide page is {{ u.season.place }}, {{ "%.0f"|format(king_link.km * 0.621371) }} mi away: its highest predicted tides of the season are {{ fmt_range(u.first, u.last, "en", kc) }}, highest on {{ fmt_date(u.peak.date, "en", kc) }} at {{ fmt_time(u.peak.time, "en") }}, {{ u.peak.height|feet }}. Those are that station's predictions, not this one's; the tides here can differ in time and height.</p>
  <p><a href="/king-tides/#station-{{ u.season.id }}">King tide dates and times at {{ u.season.place }}</a>.</p>
  {% endif %}
  {% if king_calendar %}<p><a href="/{{ king_calendar[0] }}">{{ king_calendar[1] }} king tides by month, November to February</a>.</p>{% endif %}
</section>
{% endif %}

{% if station.is_subordinate %}
<div class="callout">
  <p><strong>Highs and lows from a nearby reference station.</strong> NOAA predicts this station from
  {% if reference %}{% if reference_listed %}<a href="/stations/{{ reference.id }}/">{{ reference.display_name }}</a>{% else %}{{ reference.display_name }}{% endif %} (station {{ reference.id }}){% else %}station {{ station.reference_id }}{% endif %}
  with published time and height corrections. The curve between highs and lows is an estimate, drawn dashed.</p>
</div>
{% endif %}

{% for day in days %}
<section class="day" aria-labelledby="day-{{ loop.index }}" data-date="{{ day.date.isoformat() }}">
  {#- The heading is the date, which is true whenever the page is read. The
      script below adds "Today" or "Tomorrow" from the station's own clock. -#}
  <h2 id="day-{{ loop.index }}"><span class="day-label"></span><time datetime="{{ day.date.isoformat() }}">{{ day.long_date }}</time></h2>
  {% if day.events %}
  <table class="events">
    <caption class="vh">High and low tides at {{ station.display_name }}, {{ day.long_date }}</caption>
    <thead><tr><th scope="col">Tide</th><th scope="col">Time</th><th scope="col">Height</th></tr></thead>
    <tbody>
    {% for e in day.events %}
      <tr class="ev-{{ e.kind|lower }}"><th scope="row">{{ e.kind }}</th><td><time datetime="{{ e.iso }}">{{ e.time }}</time></td><td>{{ e.height_ft }} <span class="m">({{ e.height_m }})</span></td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="none">No high or low tide is predicted at this station on this day.</p>
  {% endif %}
  <p class="sky" data-sky="{{ day.date.isoformat() }}"><span class="sun">{{ day.sun_text }} {{ day.civil_text }}</span> <span class="moon">{{ day.moon_text }} {{ day.moonrise_text }}</span></p>
  {% if day.svg %}
  <figure class="chart">
    {{ day.svg|safe }}
    <figcaption id="chart-title-{{ day.date.isoformat() }}">Predicted tide curve, {{ day.long_date }}{% if day.approximate %} (dashed: estimated between highs and lows){% endif %}{% if day.sun.dark %}, shaded where the sun is down{% endif %}: {{ day.summary() }}.</figcaption>
  </figure>
  {% else %}
  <p class="none">No tide curve can be drawn for this day.</p>
  {% endif %}
</section>
{% endfor %}

{% if nearby %}
<section aria-labelledby="near">
  <h2 id="near">Nearby</h2>
  <p>Tide times at other NOAA stations within {{ nearby_miles }} miles, nearest first:</p>
  <ul class="near">
  {% for s, km in nearby %}
    <li><a href="/stations/{{ s.id }}/">{{ s.display_name }}</a> <span class="dist">{{ "%.0f"|format(km * 0.621371) if km * 0.621371 >= 1 else "under 1" }} mi</span></li>
  {% endfor %}
  </ul>
</section>
{% endif %}

<section class="upsell" aria-labelledby="week">
  <h2 id="week">The rest of the week</h2>
  <p>The 7-day table, favorites, widgets and offline use are in the Tide Hours iPhone app.
  {% if app_store_url %}<a href="{{ app_store_url }}">Get Tide Hours on the App Store</a>.{% else %}<strong>Coming soon to the App Store.</strong>{% endif %}
  NOAA also publishes its own <a href="https://tidesandcurrents.noaa.gov/noaatidepredictions.html?id={{ station.id }}">predictions for station {{ station.id }}</a>.</p>
</section>
{% if booklet %}
{% include "_booklet.html.jinja" %}
{% endif %}
{% if calendar %}
{% include "_calendar.html.jinja" %}
{% endif %}

{% if tide_type %}
<section class="tide-type" aria-labelledby="type" data-tide-type="{{ tide_type.kind.key }}">
  <h2 id="type">Type of tide: {{ tide_type.kind.label|lower }}</h2>
  <p>{{ tide_type.kind.meaning }}</p>
  <p class="meta">Computed from this station's NOAA harmonic constants: the form factor (K1 + O1) / (M2 + S2) is {{ "%.2f"|format(tide_type.form_factor) }}. Under 0.25 is semidiurnal, 0.25 to 1.5 mixed and mainly semidiurnal, 1.5 to 3 mixed and mainly diurnal, and over 3 diurnal, as in NOAA's Tide and Current Glossary. It describes the usual pattern; the highs and lows above are the ones for each day.</p>
</section>
{% endif %}

{% if king_season and not (king_link and king_link.own) %}
<section aria-labelledby="king">
  <h2 id="king">King tides</h2>
  {% if king_next %}
  {% set peak = king_next|max(attribute="height") %}
  <p>The next run of this station's highest predicted tides this season: {{ king_next[0].date|short_date_iso }}{% if king_next|length > 1 %} to {{ king_next[-1].date|short_date_iso }}{% endif %}, peaking at {{ peak.height|feet }} ({{ (king_season.above_mhhw(peak))|feet }} above a normal high tide). <a href="/king-tides/#station-{{ station.id }}">All king tide dates</a>.</p>
  {% else %}
  <p><a href="/king-tides/#station-{{ station.id }}">This season's king tide dates</a>.</p>
  {% endif %}
  {% if king_calendar %}<p><a href="/{{ king_calendar[0] }}">{{ king_calendar[1] }} king tides by month, November to February</a>.</p>{% endif %}
</section>
{% endif %}

{% if station.is_subordinate and reference %}{% include "_subordinate.html.jinja" %}{% endif %}
{% if derived %}
<section aria-labelledby="derived">
  <h2 id="derived">Stations predicted from this one</h2>
  <p>NOAA predicts the highs and lows at {{ derived|length }} other station{{ "s" if derived|length != 1 }} from this station's, with published time and height corrections. The time corrections{% if derived|length > 1 %}, nearest station first{% endif %}:</p>
  <ul class="derived">
  {% for d in derived %}
    <li><a href="/stations/{{ d.station.id }}/">{{ d.station.display_name }}</a> <span class="dist">{{ "%.0f"|format(d.km * 0.621371) }} mi</span>: high tide {{ minutes(d.offsets.high_time_minutes) }}, low tide {{ minutes(d.offsets.low_time_minutes) }}</li>
  {% endfor %}
  </ul>
</section>
{% endif %}

<section class="about-numbers" aria-labelledby="what">
  <h2 id="what">What these numbers are</h2>
  <p>These are predicted astronomical tides, computed from NOAA CO-OPS harmonic constants{% if station.is_subordinate %} and the station's published offsets{% endif %} with the same method as the Tide Hours app. They are predictions, not observed water levels, and not for navigation. Wind, storms, river flow and air pressure can push the real water above or below them. Sunrise, sunset, twilight and the moon are computed for the station's position with NOAA's Solar Calculator equations and Jean Meeus's <cite>Astronomical Algorithms</cite>; hills and buildings can hide the real sunrise. Tide Hours is not a NOAA product and is not endorsed by NOAA. <a href="/about/">How the predictions are made and checked</a>.</p>
  <p class="meta">Station {{ station.id }} · {{ "%.4f"|format(station.lat) }}, {{ "%.4f"|format(station.lon) }} · NOAA data retrieved {{ retrieved }} · page built {{ built }} (UTC)</p>
</section>
{% endblock %}
{% block scripts %}
<script>
// The page is built once a day at 11:20 UTC, so the days on it are the
// station's dates at that moment. Which one is "today" depends on when it is
// read: before dawn on the East Coast, and for most of the day in Guam, the
// first day on the page is already yesterday. Label the days from the
// station's own clock (its IANA zone), hide the ones that have passed, and say
// plainly when today is not on the page. Without the script, or if the zone
// is unknown to the browser, the headings stay plain dates, which are true.
var tidehoursDays = (function () {
  function isoDay(tz, now) {
    return new Intl.DateTimeFormat("en-CA", {
      timeZone: tz, year: "numeric", month: "2-digit", day: "2-digit"
    }).format(now);
  }
  function addDays(iso, n) {
    var d = new Date(iso + "T12:00:00Z");
    d.setUTCDate(d.getUTCDate() + n);
    return d.toISOString().slice(0, 10);
  }
  function words(iso) {
    return new Intl.DateTimeFormat("en-US", {
      timeZone: "UTC", weekday: "long", month: "long", day: "numeric", year: "numeric"
    }).format(new Date(iso + "T12:00:00Z"));
  }
  // dates: the ISO dates on the page, in order. Returns, per date, its label
  // ("Today", "Tomorrow" or "" for a plain date) and whether to hide it, and
  // a message when the station's today is not among them.
  function plan(dates, tz, now) {
    var today = isoDay(tz, now);
    var tomorrow = addDays(today, 1);
    var days = dates.map(function (d) {
      return {
        date: d,
        hide: d < today,
        label: d === today ? "Today" : d === tomorrow ? "Tomorrow" : ""
      };
    });
    var message = "";
    if (dates.indexOf(today) < 0) {
      var shown = dates.map(words).join(" and ");
      message = "Today, " + words(today) + ", is not on this page yet. It has " + shown +
        (dates[dates.length - 1] < today ? ", which have passed" : "") +
        ". The site updates once a day; NOAA's own predictions for this station are linked below.";
    }
    return { today: today, days: days, message: message };
  }
  return { plan: plan };
})();
(function () {
  var main = document.getElementById("main");
  var sections = Array.prototype.slice.call(document.querySelectorAll("section.day[data-date]"));
  var result;
  try {
    result = tidehoursDays.plan(sections.map(function (s) { return s.getAttribute("data-date"); }),
      main.getAttribute("data-tz"), new Date());
  } catch (e) { return; }
  sections.forEach(function (s, i) {
    var day = result.days[i];
    if (day.label) s.querySelector(".day-label").textContent = day.label + ", ";
    if (day.hide) s.hidden = true;
  });
  var byDate = {};
  result.days.forEach(function (d) { byDate[d.date] = d; });
  Array.prototype.forEach.call(document.querySelectorAll(".answer li[data-date]"), function (li) {
    var day = byDate[li.getAttribute("data-date")];
    if (!day) return;
    if (day.label) li.querySelector(".day-label").textContent = day.label + ", ";
    if (day.hide) li.hidden = true;
  });
  if (result.message) {
    var box = document.getElementById("stale");
    box.textContent = result.message;
    box.hidden = false;
  }
})();
</script>
{% endblock %}
